# Virtual environment
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing & quality tooling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment variables / secrets
.env
.env.*
!.env.example

# Data generated during experiments
data/raw/*
data/processed/*
data/outcomes/*
data/splits/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/outcomes/.gitkeep
!data/splits/.gitkeep

# Experiment outputs & logs
reports/generated/
*.log

# Checkpoints and local model weights
checkpoints/
*.pt
*.bin
*.safetensors
*.onnx

# Scratch & temporary workspace
scratch/
tmp/
temp/

# IDE & editors
.vscode/
.idea/
*.swp
*.swo

# AI / IDE Agent configs
.agents/
.gemini/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini